# Environment Variables Example

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration for local MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=whatsapp_messages
DB_PORT=3306

# Database Configuration for Production MySQL
DB_HOST=72.72.42.59
DB_USER=root
DB_PASSWORD=us!gw6y!ka$^
DB_NAME=twitter_scrapper
DB_PORT=4487

# Attachment Configuration
ATTACHMENT_PATH=/Users/apple1/Downloads/WHATSAPP_DOCS/

# Wasender API Configuration (Required)
WASENDER_API_KEY=your_session_api_key_here
WASENDER_PERSONAL_ACCESS_TOKEN=your_account_token_here
WASENDER_WEBHOOK_SECRET=your_webhook_secret_here
WASENDER_BASE_URL=https://wasenderapi.com
WASENDER_SESSION_NAME=group_monitor_session

# Webhook Configuration
WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhook/wasender
NGROK_AUTH_TOKEN=your_ngrok_token_here

# File Storage Configuration
MAX_FILE_SIZE=50MB
ALLOWED_MEDIA_TYPES=image,video,audio,document

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/wasender-migration.log
LOG_ROTATION=daily
LOG_MAX_FILES=30

# Security Configuration
WEBHOOK_IP_WHITELIST=127.0.0.1,::1

# Rate Limiting Configuration
WEBHOOK_RATE_LIMIT_WINDOW_MS=900000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=1000

# Session Management Configuration
SESSION_HEALTH_CHECK_INTERVAL=300000
SESSION_RECONNECT_MAX_ATTEMPTS=5
SESSION_RECONNECT_DELAY=30000
