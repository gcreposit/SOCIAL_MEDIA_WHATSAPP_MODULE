# Production Environment Configuration
# Copy this file to .env.production and update with actual production values

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration for Production MySQL
DB_HOST=72.72.42.59
DB_USER=root
DB_PASSWORD=us!gw6y!ka$^
DB_NAME=twitter_scrapper
DB_PORT=4487

# Production Attachment Configuration
ATTACHMENT_PATH=/var/app/attachments/
ATTACHMENT_BACKUP_PATH=/var/app/attachments/backup/

# Wasender API Configuration (Production)
WASENDER_API_KEY=your_production_session_api_key_here
WASENDER_PERSONAL_ACCESS_TOKEN=your_production_account_token_here
WASENDER_WEBHOOK_SECRET=your_production_webhook_secret_here
WASENDER_BASE_URL=https://wasenderapi.com
WASENDER_SESSION_NAME=production_group_monitor

# Production Webhook Configuration
WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhook/wasender
WEBHOOK_URL=https://your-production-domain.com/webhook/wasender

# File Storage Configuration
MAX_FILE_SIZE=100MB
ALLOWED_MEDIA_TYPES=image,video,audio,document

# Production Logging Configuration
LOG_LEVEL=warn
LOG_FILE_PATH=/var/log/wasender-migration/wasender-migration.log
LOG_ERROR_FILE_PATH=/var/log/wasender-migration/wasender-migration-error.log
LOG_ROTATION=daily
LOG_MAX_FILES=90
LOG_MAX_SIZE=100m

# Security Configuration
WEBHOOK_IP_WHITELIST=0.0.0.0/0
CORS_ORIGIN=https://your-production-domain.com

# Rate Limiting Configuration (More restrictive for production)
WEBHOOK_RATE_LIMIT_WINDOW_MS=900000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=2000

# Session Management Configuration
SESSION_HEALTH_CHECK_INTERVAL=180000
SESSION_RECONNECT_MAX_ATTEMPTS=10
SESSION_RECONNECT_DELAY=60000

# Monitoring Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
METRICS_ENABLED=true
METRICS_PATH=/metrics

# SSL Configuration (if using HTTPS)
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/your-cert.pem
SSL_KEY_PATH=/etc/ssl/private/your-key.pem

# Process Management
PM2_INSTANCES=max
PM2_MAX_MEMORY_RESTART=1000M
PM2_LOG_DATE_FORMAT=YYYY-MM-DD HH:mm:ss Z

# Database Connection Pool (Production optimized)
DB_CONNECTION_LIMIT=20
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000
DB_RETRY_MAX=3